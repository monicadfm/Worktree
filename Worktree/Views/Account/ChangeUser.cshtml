@model Worktree.Models.ChangeUserViewModel
@{
    ViewData["Title"] = "My Profile";
    var initials = ((Model.FirstName.Length > 0 ? Model.FirstName[..1] : "") + (Model.LastName.Length > 0 ? Model.LastName[..1] : "")).ToUpper();
}

<a asp-controller="Home" asp-action="Index" class="back-link">&larr; Back to dashboard</a>

<div class="card form-card form-card-wide">
    <div class="form-card-head">
        <div class="dropdown">
            <button type="button" class="avatar-upload" data-bs-toggle="dropdown" aria-expanded="false"
                    aria-label="Change picture" data-initials="@initials">
                @if (!string.IsNullOrEmpty(Model.AvatarUrl))
                {
                    <img src="@Model.AvatarUrl" alt="" id="avatar-preview" class="avatar avatar-lg" referrerpolicy="no-referrer" />
                }
                else
                {
                    <span id="avatar-preview" class="avatar avatar-lg">@initials</span>
                }
                <span class="avatar-upload-overlay" aria-hidden="true">+</span>
            </button>
            <ul class="dropdown-menu card-menu">
                <li>
                    <label for="AvatarFile" class="dropdown-item">
                        <svg class="icon" viewBox="0 0 24 24"><path d="M12 15V4M7 9l5-5 5 5M4 15v4a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-4" /></svg>
                        Upload picture
                    </label>
                </li>
                <li id="avatar-remove-item" class="@(string.IsNullOrEmpty(Model.AvatarUrl) ? "d-none" : "")">
                    <button type="button" id="avatar-remove" class="dropdown-item menu-danger">
                        <svg class="icon" viewBox="0 0 24 24"><path d="M4 7h16M10 11v6M14 11v6M6 7l1 12a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1l1-12M9 7V4h6v3" /></svg>
                        Remove picture
                    </button>
                </li>
            </ul>
        </div>
        <div>
            <h1>@Model.FirstName @Model.LastName</h1>
            <p>@(string.IsNullOrEmpty(Model.JobTitle) ? "No job title yet" : Model.JobTitle) &middot; @this.User.Identity!.Name</p>
            <span class="field-hint" id="avatar-file-name">Click your picture to upload or remove it. JPG, PNG or WEBP, up to 2 MB.</span>
        </div>
    </div>

    <form method="post" enctype="multipart/form-data" class="form-stack">
        @if (ViewBag.UserMessage != null)
        {
            <div class="auth-success">@ViewBag.UserMessage</div>
        }
        <div asp-validation-summary="ModelOnly" class="auth-error"></div>
        <input asp-for="AvatarFile" type="file" class="d-none" accept=".jpg,.jpeg,.png,.webp" />
        <input type="hidden" asp-for="AvatarUrl" />
        <span asp-validation-for="AvatarFile" class="field-error"></span>

        <div class="auth-row">
            <div>
                <label asp-for="FirstName" class="form-label"></label>
                <input asp-for="FirstName" class="form-control" />
                <span asp-validation-for="FirstName" class="field-error"></span>
            </div>
            <div>
                <label asp-for="LastName" class="form-label"></label>
                <input asp-for="LastName" class="form-control" />
                <span asp-validation-for="LastName" class="field-error"></span>
            </div>
        </div>

        <div>
            <label asp-for="JobTitle" class="form-label">Job title <span class="optional">(optional)</span></label>
            <input asp-for="JobTitle" class="form-control" placeholder="e.g. Frontend developer" />
            <span asp-validation-for="JobTitle" class="field-error"></span>
        </div>

        <div>
            <div class="field-row">
                <label asp-for="Bio" class="form-label">Bio <span class="optional">(optional)</span></label>
                <span class="field-hint m-0"><span id="bio-count">@(Model.Bio?.Length ?? 0)</span>/500</span>
            </div>
            <textarea asp-for="Bio" class="form-control" rows="3" maxlength="500"
                      oninput="document.getElementById('bio-count').textContent = this.value.length"></textarea>
            <span asp-validation-for="Bio" class="field-error"></span>
        </div>

        <input asp-for="RemoveAvatar" type="checkbox" class="d-none" />

        <div class="auth-row">
            <div>
                <label asp-for="Theme" class="form-label"></label>
                <select asp-for="Theme" asp-items="Html.GetEnumSelectList<Worktree.Data.Entities.AppTheme>()" class="form-select"></select>
            </div>
            <div>
                <label asp-for="DefaultProjectId" class="form-label"></label>
                <select asp-for="DefaultProjectId" asp-items="Model.Projects" class="form-select"></select>
                <span asp-validation-for="DefaultProjectId" class="field-error"></span>
            </div>
        </div>

        <div class="form-footer">
            <button type="submit" class="btn btn-primary">Save profile</button>
            <a asp-action="ChangeUser" class="btn btn-line">Discard changes</a>
            <a asp-action="ChangePassword" class="btn btn-line push-right">Change password</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
