@model Worktree.Models.ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
}

<a asp-action="ChangeUser" class="back-link">&larr; Back to profile</a>

<div class="card form-card">
    <div class="form-card-head">
        <div>
            <h1>Change password</h1>
            <p>For @this.User.Identity!.Name</p>
        </div>
    </div>

    <form method="post" class="form-stack">
        <div asp-validation-summary="ModelOnly" class="auth-error"></div>

        <div>
            <label asp-for="OldPassword" class="form-label">Current password</label>
            <input asp-for="OldPassword" class="form-control" autocomplete="current-password" />
            <span asp-validation-for="OldPassword" class="field-error"></span>
        </div>

        <div>
            <label asp-for="NewPassword" class="form-label">New password</label>
            <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
            <span class="field-hint">At least 8 characters.</span>
            <span asp-validation-for="NewPassword" class="field-error"></span>
        </div>

        <div>
            <label asp-for="Confirm" class="form-label">Confirm new password</label>
            <input asp-for="Confirm" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="Confirm" class="field-error"></span>
        </div>

        <div class="form-footer">
            <button type="submit" class="btn btn-primary">Save new password</button>
            <a asp-action="ChangeUser" class="btn btn-line">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
