@model Worktree.Models.RecoverPasswordViewModel
@{
    ViewData["Title"] = "Forgot password";
    Layout = "_AuthLayout";
}

<a class="auth-back" asp-action="Login">&larr; Back to sign in</a>

<h1>Forgot your password?</h1>
<p class="auth-sub">Enter your account email and we'll send you a link to choose a new one.</p>

<form method="post" class="auth-form">
    @if (ViewBag.Message != null)
    {
        <div class="auth-success">@ViewBag.Message</div>
    }
    <div asp-validation-summary="ModelOnly" class="auth-error"></div>

    <div>
        <label asp-for="Email" class="form-label">Email</label>
        <input asp-for="Email" class="form-control" autocomplete="email" autofocus />
        <span asp-validation-for="Email" class="field-error"></span>
    </div>

    <button type="submit" class="btn btn-primary">Send reset link</button>

    <div class="auth-links auth-center">
        <span>Remembered it? <a asp-action="Login">Sign in</a></span>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
