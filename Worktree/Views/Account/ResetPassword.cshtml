@model Worktree.Models.ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset password";
    Layout = "_AuthLayout";
    var message = ViewBag.Message as string;
    var success = message == "Password reset successful.";
}

<a class="auth-back" asp-action="Login">&larr; Back to sign in</a>

<h1>Choose a new password</h1>
<p class="auth-sub">Use the email you signed up with and pick a new password.</p>

@if (success)
{
    <div class="auth-form">
        <div class="auth-success">Your password was changed. You can sign in with it now.</div>
        <a asp-action="Login" class="btn btn-primary">Sign in</a>
    </div>
}
else
{
    <form method="post" class="auth-form">
        @if (message != null)
        {
            <div class="auth-error">@message</div>
        }
        <div asp-validation-summary="ModelOnly" class="auth-error"></div>
        <input asp-for="Token" type="hidden" />

        <div>
            <label asp-for="Username" class="form-label">Email</label>
            <input asp-for="Username" class="form-control" autocomplete="email" autofocus />
            <span asp-validation-for="Username" class="field-error"></span>
        </div>

        <div>
            <label asp-for="Password" class="form-label">New password</label>
            <input asp-for="Password" class="form-control" autocomplete="new-password" />
            <span class="field-hint">At least 6 characters.</span>
            <span asp-validation-for="Password" class="field-error"></span>
        </div>

        <div>
            <label asp-for="ConfirmPassword" class="form-label">Confirm password</label>
            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="field-error"></span>
        </div>

        <button type="submit" class="btn btn-primary">Save new password</button>
    </form>
}

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
