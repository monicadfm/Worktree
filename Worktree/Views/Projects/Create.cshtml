@model Worktree.Models.ProjectViewModel

@{
    ViewData["Title"] = "New Project";
    var fromBoard = ViewBag.ReturnTo == "board";
}

@if (fromBoard)
{
    <a asp-controller="Tasks" asp-action="Board" class="back-link">&larr; Back to board</a>
}
else
{
    <a asp-action="Index" class="back-link">&larr; Back to projects</a>
}

<div class="card form-card">
    <div class="form-card-head">
        <span class="key-tile tile-0">+</span>
        <div>
            <h1>New project</h1>
            <p>You'll be its Owner and can invite your team afterwards.</p>
        </div>
    </div>

    <form asp-action="Create" class="form-stack">
        <input type="hidden" name="returnTo" value="@ViewBag.ReturnTo" />
        <div asp-validation-summary="ModelOnly" class="auth-error"></div>

        <div>
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" placeholder="e.g. Website relaunch" autofocus />
            <span asp-validation-for="Name" class="field-error"></span>
        </div>

        <div>
            <label asp-for="Key" class="form-label"></label>
            <input asp-for="Key" class="form-control key-input" maxlength="5" placeholder="e.g. WEB"
                   oninput="this.value = this.value.toUpperCase()" />
            <span class="field-hint">2–5 uppercase letters. Used in task numbers (WEB-12).</span>
            <span asp-validation-for="Key" class="field-error"></span>
        </div>

        <div>
            <div class="field-row">
                <label asp-for="Description" class="form-label">Description <span class="optional">(optional)</span></label>
                <span class="field-hint m-0"><span id="desc-count">@(Model?.Description?.Length ?? 0)</span>/1000</span>
            </div>
            <textarea asp-for="Description" class="form-control" rows="4" maxlength="1000"
                      oninput="document.getElementById('desc-count').textContent = this.value.length"></textarea>
            <span asp-validation-for="Description" class="field-error"></span>
        </div>

        <div class="form-footer">
            <button type="submit" class="btn btn-primary">Create project</button>
            @if (fromBoard)
            {
                <a asp-controller="Tasks" asp-action="Board" class="btn btn-line">Cancel</a>
            }
            else
            {
                <a asp-action="Index" class="btn btn-line">Cancel</a>
            }
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
