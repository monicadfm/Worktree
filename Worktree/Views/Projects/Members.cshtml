@model Worktree.Models.ProjectMembersViewModel

@{
    ViewData["Title"] = "Members - " + Model.Project.Name;
    ViewData["Nav"] = "Board";
}

<partial name="_BoardHeader" model="Model.Header" />

<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

@if (!Model.IsOwner)
{
    <p class="note">Only Owners can add or remove members and change roles.</p>
}

<div class="card list-card">
    @foreach (var member in Model.Project.Members.OrderBy(m => m.Role).ThenBy(m => m.User.FirstName))
    {
        var isMe = member.UserId == Model.CurrentUserId;

        <div class="member-row">
            <span class="avatar avatar-md">@member.User.Initials</span>

            <div class="member-info">
                <span class="member-name">@member.User.FullName@(isMe ? " (you)" : "")</span>
                <span class="member-email">@member.User.Email</span>
            </div>

            <div class="member-actions">
                <span class="pill role-@member.Role.CssName()">@member.Role</span>

                @if (Model.IsOwner)
                {
                    <form asp-action="ChangeRole" method="post">
                        <input type="hidden" name="projectId" value="@Model.ProjectId" />
                        <input type="hidden" name="userId" value="@member.UserId" />
                        <input type="hidden" name="role" value="@(member.Role == UserRoles.Owner ? UserRoles.Member : UserRoles.Owner)" />
                        <button type="submit" class="btn btn-line btn-sm">
                            @(member.Role == UserRoles.Owner ? "Make member" : "Make owner")
                        </button>
                    </form>
                }

                @if (Model.IsOwner || isMe)
                {
                    <form asp-action="RemoveMember" method="post"
                          onsubmit="return confirm('@(isMe ? "Leave this project?" : "Remove " + member.User.FullName + " from the project?")');">
                        <input type="hidden" name="projectId" value="@Model.ProjectId" />
                        <input type="hidden" name="userId" value="@member.UserId" />
                        <button type="submit" class="btn btn-line-danger btn-sm">@(isMe && !Model.IsOwner ? "Leave" : "Remove")</button>
                    </form>
                }
            </div>
        </div>
    }

    @if (Model.IsOwner)
    {
        <form asp-action="AddMember" method="post" class="add-member">
            <input type="hidden" asp-for="ProjectId" />
            <input type="hidden" asp-for="Role" />

            <label asp-for="Email" class="add-member-label">Add member by email</label>
            <input asp-for="Email" class="form-control" placeholder="name@worktree.dev" autocomplete="off" />
            <button type="submit" class="btn btn-primary">Add</button>
        </form>
        <span asp-validation-for="Email" class="add-member-error"></span>
    }
</div>

@if (Model.IsOwner)
{
    <div class="card panel danger-zone">
        <h2>Danger zone</h2>
        <div class="danger-actions">
            <form asp-action="ToggleArchive" asp-route-id="@Model.ProjectId" method="post">
                <input type="hidden" name="returnTo" value="members" />
                <button type="submit" class="btn btn-line">@(Model.Project.IsArchived ? "Unarchive project" : "Archive project")</button>
            </form>
            <a asp-action="Delete" asp-route-id="@Model.ProjectId" class="btn btn-danger">Delete project</a>
        </div>
    </div>
}

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
