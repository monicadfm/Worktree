@model IEnumerable<Worktree.Data.Entities.Project>

@{
    ViewData["Title"] = "My Projects";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>My Projects</h1>
    <a asp-action="Create" class="btn btn-primary">New Project</a>
</div>

@if (!Model.Any())
{
    <div class="text-center text-muted py-5">
        <p>You're not a member of any project yet.</p>
        <a asp-action="Create" class="btn btn-outline-primary">Create your first project</a>
    </div>
}
else
{
    <table class="table align-middle">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(model => model.Key)</th>
                <th>@Html.DisplayNameFor(model => model.Name)</th>
                <th>Tasks</th>
                <th>Members</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td><span class="badge bg-dark">@item.Key</span></td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Name)
                        @if (item.IsArchived)
                        {
                            <span class="badge bg-secondary ms-1">Archived</span>
                        }
                    </td>
                    <td>@item.Tasks.Count</td>
                    <td>@item.Members.Count</td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">Details</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}