@model Worktree.Data.Entities.Project

@{
    ViewData["Title"] = "Delete Project";
    var taskCount = (int)(ViewBag.TaskCount ?? 0);
}

<a asp-action="Index" class="back-link">&larr; Back to projects</a>

<div class="card form-card">
    <div class="form-card-head">
        <span class="key-tile tile-@(Model.Id % 4)">@Model.Key</span>
        <div>
            <h1>Delete @Model.Name?</h1>
            <p>@taskCount task@(taskCount == 1 ? "" : "s") in this project</p>
        </div>
    </div>

    <div class="form-stack">
        @if (ViewBag.ErrorMessage != null)
        {
            <div class="auth-error">@ViewBag.ErrorMessage</div>
        }

        @if (taskCount > 0)
        {
            <div class="auth-error">
                This project still has @taskCount task@(taskCount == 1 ? "" : "s"), so it can't be deleted.
                Archive it instead: it stays read-only and moves to the end of your list.
            </div>

            <div class="form-footer">
                <form asp-action="ToggleArchive" asp-route-id="@Model.Id" method="post">
                    <input type="hidden" name="returnTo" value="projects" />
                    <button type="submit" class="btn btn-primary" disabled="@Model.IsArchived">Archive project</button>
                </form>
                <a asp-action="Index" class="btn btn-line">Keep it</a>
            </div>
        }
        else
        {
            <div class="auth-error">Its members and labels will also be removed. This can't be undone.</div>

            <form asp-action="Delete" class="form-footer danger-actions">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger">Yes, delete</button>
                <a asp-action="Index" class="btn btn-line">Keep it</a>
            </form>
        }
    </div>
</div>
