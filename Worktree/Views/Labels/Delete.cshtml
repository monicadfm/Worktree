@model Worktree.Data.Entities.Label

@{
    ViewData["Title"] = "Delete Label";
    var taskCount = (int)(ViewBag.TaskCount ?? 0);
    var project = (Project)ViewBag.Project;
}

<a asp-action="Index" asp-route-projectId="@project.Id" class="back-link">&larr; Back to labels</a>

<div class="card form-card">
    <div class="form-card-head">
        <span class="key-tile tile-@(project.Id % 4)">@project.Key</span>
        <div>
            <h1>Delete label?</h1>
            <p><span class="label-tag" style="color: @Model.Color; border-color: @Model.Color">@Model.Name</span></p>
        </div>
    </div>

    <form asp-action="Delete" class="form-stack">
        <input type="hidden" asp-for="Id" />

        <div class="auth-error">
            @if (taskCount > 0)
            {
                <text>This label is used by @taskCount task@(taskCount == 1 ? "" : "s"). It will be removed from them, but the tasks won't be deleted.</text>
            }
            else
            {
                <text>Delete "@Model.Name"? This can't be undone.</text>
            }
        </div>

        <div class="form-footer danger-actions">
            <button type="submit" class="btn btn-danger">Yes, delete</button>
            <a asp-action="Index" asp-route-projectId="@project.Id" class="btn btn-line">Keep it</a>
        </div>
    </form>
</div>
