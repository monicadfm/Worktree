@model Worktree.Data.Entities.Label

@{
    ViewData["Title"] = "Delete Label";
    var taskCount = (int)(ViewBag.TaskCount ?? 0);
    var project = (Project)ViewBag.Project;
}

<h1>Delete Label</h1>
<hr />

<h3>Are you sure you want to delete <span class="badge" style="background-color: @Model.Color">@Model.Name</span>?</h3>

@if (taskCount > 0)
{
    <div class="alert alert-warning mt-3">
        This label is used by <strong>@taskCount task(s)</strong>. It will be removed from them, but the tasks won't be deleted.
    </div>
}

<form asp-action="Delete" class="mt-3">
    <input type="hidden" asp-for="Id" />
    <input type="submit" value="Delete" class="btn btn-danger" />
    <a asp-action="Index" asp-route-projectId="@project.Id" class="btn btn-success">Back to List</a>
</form>