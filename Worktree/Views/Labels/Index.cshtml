@model IEnumerable<Worktree.Data.Entities.Label>

@{
    var project = (Project)ViewBag.Project;
    var isOwner = ViewBag.IsOwner == true;
    ViewData["Title"] = project.Name + " - Labels";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1><span class="badge bg-secondary align-middle">@project.Key</span> Labels</h1>
    <div>
        @if (isOwner && !project.IsArchived)
        {
            <a asp-action="Create" asp-route-projectId="@project.Id" class="btn btn-primary">New Label</a>
        }
        <a asp-controller="Projects" asp-action="Details" asp-route-id="@project.Id" class="btn btn-success">Back to Project</a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="text-center text-muted py-5">
        <p>No labels yet.</p>
    </div>
}
else
{
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Label</th>
                <th>Color</th>
                <th>Used by</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td><span class="badge" style="background-color: @item.Color">@item.Name</span></td>
                    <td class="text-muted">@item.Color</td>
                    <td>@item.TaskLabels.Count task(s)</td>
                    <td class="text-end">
                        @if (isOwner && !project.IsArchived)
                        {
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Edit</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Delete</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}