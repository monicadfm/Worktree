@model IEnumerable<Worktree.Data.Entities.Label>

@{
    var project = (Project)ViewBag.Project;
    var isOwner = ViewBag.IsOwner == true;
    var canEdit = isOwner && !project.IsArchived;
    ViewData["Title"] = project.Name + " - Labels";
}

<partial name="_BoardHeader" model="ViewBag.Header" />

<div class="labels-page">
    <p class="tab-intro">These labels only exist in @project.Key. Each name can be used once per project.</p>

    @if (canEdit)
    {
        <partial name="_LabelInlineForm" model="ViewBag.NewLabel" />
    }
    else if (!isOwner)
    {
        <p class="note">Only Owners can add, edit or delete labels.</p>
    }

    @if (!Model.Any())
    {
        <div class="card panel text-center text-muted">No labels yet.</div>
    }
    else
    {
        <div class="card list-card">
            @foreach (var item in Model)
            {
                var count = item.TaskLabels.Count;

                <div class="label-row">
                    <span class="label-tag" style="color: @item.Color; border-color: @item.Color">@item.Name</span>
                    <span class="key">@item.Color.ToUpper()</span>
                    <span class="label-usage">Used by @count @(count == 1 ? "task" : "tasks")</span>

                    @if (canEdit)
                    {
                        <div class="label-row-actions">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-line btn-sm">Edit</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-line-danger btn-sm">Delete</a>
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        const picker = document.getElementById("label-color-picker");
        const hex = document.getElementById("Color");
        const nameInput = document.getElementById("Name");
        const preview = document.getElementById("label-preview");
        const hexPattern = /^#[0-9A-Fa-f]{6}$/;

        if (picker && hex && nameInput && preview) {
            const updatePreview = () => {
                const color = hexPattern.test(hex.value) ? hex.value : picker.value;
                preview.style.color = color;
                preview.style.borderColor = color;
                preview.textContent = nameInput.value.trim() || "label";
            };

            picker.addEventListener("input", () => {
                hex.value = picker.value.toUpperCase();
                updatePreview();
            });

            hex.addEventListener("input", () => {
                if (hexPattern.test(hex.value)) {
                    picker.value = hex.value;
                }
                updatePreview();
            });

            nameInput.addEventListener("input", updatePreview);
        }
    </script>
}
