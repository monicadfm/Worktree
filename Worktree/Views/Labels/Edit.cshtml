@model Worktree.Models.LabelViewModel

@{
    ViewData["Title"] = "Edit label";
}

<a asp-action="Index" asp-route-projectId="@Model.ProjectId" class="back-link">&larr; Back to labels</a>

<div class="card form-card">
    <div class="form-card-head">
        <span class="key-tile tile-@(Model.ProjectId % 4)">@Model.ProjectKey</span>
        <div>
            <h1>Edit label</h1>
            <p>This label only exists in @Model.ProjectKey.</p>
        </div>
    </div>

    <form asp-action="Edit" class="form-stack">
        <div asp-validation-summary="ModelOnly" class="auth-error"></div>
        <input type="hidden" asp-for="Id" />

        <partial name="_LabelForm" />

        <div class="form-footer">
            <button type="submit" class="btn btn-primary">Save changes</button>
            <a asp-action="Index" asp-route-projectId="@Model.ProjectId" class="btn btn-line">Cancel</a>
            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-line-danger push-right">Delete label</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
