@model Worktree.Models.DashboardViewModel?

@{
    ViewData["Title"] = Model == null ? "Home Page" : "Dashboard";
}

@if (Model == null)
{
    <div class="text-center mt-5">
        <h1 class="display-4">Worktree</h1>
        <p class="lead">Organize your projects, tasks and team in one place.</p>

        <div class="mt-4">
            <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-lg me-2">Login</a>
            <a asp-controller="Account" asp-action="Register" class="btn btn-outline-primary btn-lg">Create account</a>
        </div>
    </div>
}
else
{
    <h1 class="mb-1">Hello, @Model.FirstName!</h1>
    <p class="text-muted mb-4">Here's what's happening in your projects.</p>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <div class="display-6 fw-bold">@Model.Projects.Count</div>
                    <div class="text-muted">Active projects</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <div class="display-6 fw-bold text-primary">@Model.AssignedToMe.Count</div>
                    <div class="text-muted">Open tasks assigned to me</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <div class="display-6 fw-bold @(Model.Overdue.Any() ? "text-danger" : "text-success")">@Model.Overdue.Count</div>
                    <div class="text-muted">Overdue tasks</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-6">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h4 class="mb-0">My projects</h4>
                <a asp-controller="Projects" asp-action="Create" class="btn btn-sm btn-primary">New Project</a>
            </div>

            @if (!Model.Projects.Any())
            {
                <p class="text-muted">You're not in any active project yet.</p>
            }

            @foreach (var project in Model.Projects)
            {
                var total = project.Tasks.Count;
                var done = project.Tasks.Count(t => t.Status == TaskItemStatus.Done);
                var percent = total == 0 ? 0 : done * 100 / total;

                <div class="card mb-2 shadow-sm">
                    <div class="card-body py-2">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <span class="badge bg-dark">@project.Key</span>
                                <a asp-controller="Projects" asp-action="Details" asp-route-id="@project.Id"
                                   class="fw-semibold text-decoration-none text-dark ms-1">@project.Name</a>
                            </div>
                            <a asp-controller="Tasks" asp-action="Board" asp-route-projectId="@project.Id" class="btn btn-sm btn-outline-dark">Board</a>
                        </div>
                        <div class="progress mt-2" style="height: 8px">
                            <div class="progress-bar bg-success" style="width: @percent%"></div>
                        </div>
                        <small class="text-muted">@done / @total tasks done · @project.Members.Count member(s)</small>
                    </div>
                </div>
            }
        </div>

        <div class="col-lg-6">
            <h4>Assigned to me</h4>

            @if (!Model.AssignedToMe.Any())
            {
                <p class="text-muted">Nothing assigned to you. 🎉</p>
            }
            else
            {
                <div class="list-group mb-4">
                    @foreach (var task in Model.AssignedToMe)
                    {
                        var overdue = task.DueDate.HasValue && task.DueDate.Value.Date < DateTime.Today;

                        <a asp-controller="Tasks" asp-action="Details" asp-route-id="@task.Id"
                           class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                            <span>
                                <small class="text-muted me-1">@task.Project.Key-@task.Number</small>
                                @task.Title
                            </span>
                            <span>
                                <span class="badge bg-light text-dark">@task.Status.GetDisplayName()</span>
                                @if (task.DueDate.HasValue)
                                {
                                    <small class="ms-1 @(overdue ? "text-danger fw-bold" : "text-muted")">@task.DueDate.Value.ToString("dd/MM")</small>
                                }
                            </span>
                        </a>
                    }
                </div>
            }

            <h4 class="text-danger">Overdue</h4>

            @if (!Model.Overdue.Any())
            {
                <p class="text-muted">No overdue tasks. Nice work!</p>
            }
            else
            {
                <div class="list-group">
                    @foreach (var task in Model.Overdue)
                    {
                        <a asp-controller="Tasks" asp-action="Details" asp-route-id="@task.Id"
                           class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                            <span>
                                <small class="text-muted me-1">@task.Project.Key-@task.Number</small>
                                @task.Title
                            </span>
                            <span>
                                <small class="text-muted me-1">@(task.Assignee?.FullName ?? "Unassigned")</small>
                                <small class="text-danger fw-bold">@task.DueDate!.Value.ToString("dd/MM")</small>
                            </span>
                        </a>
                    }
                </div>
            }
        </div>
    </div>
}