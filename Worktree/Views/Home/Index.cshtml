@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center mt-5">
    <h1 class="display-4">Worktree</h1>
    <p class="lead">Organize your projects, tasks and team in one place.</p>

    @if (this.User.Identity!.IsAuthenticated)
    {
        <p>Welcome back, <strong>@this.User.Identity.Name</strong>!</p>
    }
    else
    {
        <div class="mt-4">
            <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-lg me-2">Login</a>
            <a asp-controller="Account" asp-action="Register" class="btn btn-outline-primary btn-lg">Create account</a>
        </div>
    }
</div>