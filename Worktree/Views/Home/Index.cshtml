@model Worktree.Models.DashboardViewModel?

@{
    ViewData["Title"] = Model == null ? "Home Page" : "Dashboard";
}

@if (Model == null)
{
    <div class="text-center mt-5">
        <h1 class="display-4">Worktree</h1>
        <p class="lead">Organize your projects, tasks and team in one place.</p>

        <div class="mt-4">
            <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-lg me-2">Login</a>
            <a asp-controller="Account" asp-action="Register" class="btn btn-outline-primary btn-lg">Create account</a>
        </div>
    </div>
}
else
{
    var hour = DateTime.Now.Hour;
    var greeting = hour < 12 ? "Good morning" : hour < 19 ? "Good afternoon" : "Good evening";

    var focus = Model.Projects.FirstOrDefault();
    var focusTotal = focus?.Tasks.Count ?? 0;
    var focusDone = focus?.Tasks.Count(t => t.Status == TaskItemStatus.Done) ?? 0;
    var focusPercent = focusTotal == 0 ? 0 : focusDone * 100 / focusTotal;
    var focusOverdue = focus == null ? 0 : Model.Overdue.Count(t => t.ProjectId == focus.Id);

    <h1 class="mb-1">@greeting, @Model.FirstName</h1>
    <p class="text-muted mb-4">Here's what's on your plate today.</p>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card stat-card h-100">
                <div class="stat-label">Assigned to me</div>
                <div class="stat-number">@Model.AssignedToMe.Count</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card stat-card h-100">
                <div class="stat-label">Overdue@(focus != null ? " in " + focus.Key : "")</div>
                <div class="stat-number @(focusOverdue > 0 ? "text-danger" : "")">@focusOverdue</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card stat-card h-100">
                <div class="stat-label">@(focus != null ? focus.Key + " progress" : "Progress")</div>
                <div class="stat-number">@focusPercent%</div>
                <div class="bar mt-2">
                    <div class="bar-fill" style="width: @focusPercent%"></div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card panel h-100">
                <h2 class="panel-title">My open tasks</h2>

                @if (!Model.AssignedToMe.Any())
                {
                    <p class="text-muted mb-0">Nothing assigned to you.</p>
                }

                @foreach (var task in Model.AssignedToMe)
                {
                    var overdue = task.DueDate.HasValue && task.DueDate.Value.Date < DateTime.Today;

                    <a asp-controller="Tasks" asp-action="Details" asp-route-id="@task.Id" class="task-row">
                        <span class="key task-row-key">@task.Project.Key-@task.Number</span>
                        <span class="task-row-title">@task.Title</span>
                        <span class="pill status-@task.Status.CssName()">@task.Status.GetDisplayName()</span>
                        <small class="task-row-due @(overdue ? "text-danger" : "text-muted")">
                            @(task.DueDate.HasValue ? (overdue ? "Overdue · " : "") + task.DueDate.Value.ToString("dd/MM") : "—")
                        </small>
                    </a>
                }
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card panel h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 class="mb-0">My projects</h2>
                    <a asp-controller="Projects" asp-action="Create" class="btn btn-sm btn-primary">New</a>
                </div>

                @if (!Model.Projects.Any())
                {
                    <p class="text-muted mb-0">You're not in any active project yet.</p>
                }

                @foreach (var project in Model.Projects)
                {
                    var total = project.Tasks.Count;
                    var done = project.Tasks.Count(t => t.Status == TaskItemStatus.Done);
                    var role = project.Members.FirstOrDefault(m => m.UserId == Model.UserId)?.Role;

                    <a asp-controller="Tasks" asp-action="Board" asp-route-projectId="@project.Id" class="project-item">
                        <div class="d-flex justify-content-between align-items-start">
                            <span class="fw-semibold">@project.Name</span>
                            <span class="key">@project.Key</span>
                        </div>
                        <small class="text-muted">@done of @total done · @role@(project.Id == Model.DefaultProjectId ? " · Default" : "")</small>
                    </a>
                }
            </div>
        </div>
    </div>
}
