@{
    ViewData["Title"] = "Privacy Policy";
}

<a asp-controller="Home" asp-action="Index" class="back-link">&larr; Back to home</a>

<div class="card form-card form-card-wide">
    <div class="form-card-head">
        <div>
            <h1>Privacy policy</h1>
            <p>Worktree is a student project developed for UFCD 5417 (CET 105 – CINEL).</p>
        </div>
    </div>

    <div class="form-stack">
        <div>
            <h2>What data we store</h2>
            <ul class="mb-0">
                <li>Your name and email address, used to log in and to identify you to your team.</li>
                <li>Optional profile information: job title, bio, profile picture, theme and default project.</li>
                <li>The projects, tasks, labels and comments you create.</li>
            </ul>
        </div>

        <div>
            <h2>How it's protected</h2>
            <ul class="mb-0">
                <li>Passwords are never stored in plain text: they are hashed by ASP.NET Core Identity.</li>
                <li>Projects are private: only their members can see them.</li>
                <li>Your email is only used to send password recovery links.</li>
            </ul>
        </div>

        <div class="form-footer">
            <p class="field-hint m-0">You can update your profile at any time on the <a asp-controller="Account" asp-action="ChangeUser">My Profile</a> page.</p>
        </div>
    </div>
</div>
