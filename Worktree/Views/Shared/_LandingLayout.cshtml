<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Worktree</title>
    <link rel="icon" type="image/png" href="~/img/favicon-light.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@500&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="landing-page">
    <header class="site-top">
        <div class="landing-wrap site-top-inner">
            <a class="logo" asp-controller="Home" asp-action="Index">
                <img src="~/img/logo-light.png" alt="" class="logo-icon" />
                Worktree
            </a>
            <nav class="site-top-actions">
                <a asp-controller="Account" asp-action="Login" class="btn btn-line">Sign in</a>
                <a asp-controller="Account" asp-action="Register" class="btn btn-primary">Get started</a>
            </nav>
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="site-foot">
        <div class="landing-wrap site-foot-inner">
            <span>&copy; 2026 Worktree</span>
            <span>Built with ASP.NET Core MVC</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
