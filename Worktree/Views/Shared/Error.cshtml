@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
    ViewData["Code"] = "500";
    ViewData["Heading"] = "Something went wrong";
    ViewData["Text"] = "We couldn't finish that request. Please try again.";
}

<partial name="_ErrorCard" />

@if (Model.ShowRequestId)
{
    <p class="field-hint text-center">Request ID: <span class="key">@Model.RequestId</span></p>
}
