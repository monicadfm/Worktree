@inject Worktree.Helpers.IUserHelper UserHelper
@{
    var theme = "light";
    var displayName = this.User.Identity?.Name ?? string.Empty;
    var initials = string.Empty;
    string? avatarUrl = null;
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    if (this.User.Identity!.IsAuthenticated)
    {
        var currentUser = await UserHelper.GetUserWithProfileAsync(this.User.Identity.Name!);
        if (currentUser != null)
        {
            displayName = currentUser.FullName;
            avatarUrl = currentUser.Profile?.AvatarUrl;

            if (!string.IsNullOrEmpty(currentUser.FirstName))
            {
                initials += currentUser.FirstName[0];
            }

            if (!string.IsNullOrEmpty(currentUser.LastName))
            {
                initials += currentUser.LastName[0];
            }

            initials = initials.ToUpper();

            if (currentUser.Profile?.Theme == Worktree.Data.Entities.AppTheme.Dark)
            {
                theme = "dark";
            }
        }
    }
}

<!DOCTYPE html>
<html lang="en" data-bs-theme="@theme">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Worktree</title>
    <link rel="icon" type="image/png" href="@Url.Content($"~/img/favicon-{theme}.png")" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@500&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Worktree.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm topbar mb-4">
            <div class="container">
                <a class="logo" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="@Url.Content($"~/img/logo-{theme}.png")" alt="" class="logo-icon" />
                    Worktree
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 ms-sm-4">
                        <li class="nav-item">
                            <a class="nav-link @(controller == "Home" ? "active" : "")" asp-area="" asp-controller="Home" asp-action="Index">@(this.User.Identity!.IsAuthenticated ? "Dashboard" : "Home")</a>
                        </li>
                        @if (this.User.Identity!.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(controller == "Projects" || controller == "Tasks" ? "active" : "")" asp-area="" asp-controller="Projects" asp-action="Index">Projects</a>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav align-items-sm-center">
                        @if (this.User.Identity!.IsAuthenticated)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    @if (!string.IsNullOrEmpty(avatarUrl))
                                    {
                                        <img src="@avatarUrl" alt="" class="avatar" referrerpolicy="no-referrer" />
                                    }
                                    else
                                    {
                                        <span class="avatar">@initials</span>
                                    }
                                    @displayName
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><h6 class="dropdown-header">@this.User.Identity.Name</h6></li>
                                    <li><a class="dropdown-item" asp-area="" asp-controller="Account" asp-action="ChangeUser">My Profile</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-controller="Account" asp-action="ChangePassword">Change Password</a></li>
                                </ul>
                            </li>
                            <li class="nav-item ms-sm-2">
                                <a class="btn btn-sm btn-line" asp-area="" asp-controller="Account" asp-action="Logout">Sign out</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Account" asp-action="Login">Login</a>
                            </li>
                            <li class="nav-item ms-sm-2">
                                <a class="btn btn-sm btn-primary" asp-area="" asp-controller="Account" asp-action="Register">Register</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Worktree - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>