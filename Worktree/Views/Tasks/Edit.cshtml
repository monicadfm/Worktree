@model Worktree.Models.TaskViewModel

@{
    ViewData["Title"] = "Edit Task";
}

<a asp-action="Details" asp-route-id="@Model.Id" class="back-link">&larr; Back to task</a>

<div class="card form-card form-card-wide">
    <div class="form-card-head">
        <span class="key-tile tile-@(Model.ProjectId % 4)">@Model.ProjectKey</span>
        <div>
            <h1>Edit @Model.ProjectKey-@ViewBag.Number</h1>
            <p>Change the details of this task.</p>
        </div>
    </div>

    <form asp-action="Edit" class="form-stack">
        <div asp-validation-summary="ModelOnly" class="auth-error"></div>
        <input type="hidden" asp-for="Id" />

        <partial name="_TaskForm" />

        <div class="form-footer">
            <button type="submit" class="btn btn-primary">Save changes</button>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-line">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
