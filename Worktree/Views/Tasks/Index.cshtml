@model IEnumerable<Worktree.Data.Entities.TaskItem>

@{
    var project = (Project)ViewBag.Project;
    ViewData["Title"] = project.Name + " - Tasks";
    var count = Model.Count();
}

<a asp-action="Board" asp-route-projectId="@project.Id" class="back-link">&larr; Back to board</a>

<div class="page-head">
    <div class="form-card-head mb-0">
        <span class="key-tile tile-@(project.Id % 4)">@project.Key</span>
        <div>
            <h1>All tasks</h1>
            <p>@project.Name &middot; @count task@(count == 1 ? "" : "s")</p>
        </div>
    </div>
    <div class="page-head-actions">
        <a asp-action="Board" asp-route-projectId="@project.Id" class="btn btn-line">Board view</a>
        @if (!project.IsArchived)
        {
            <a asp-action="Create" asp-route-projectId="@project.Id" class="btn btn-primary">New task</a>
        }
    </div>
</div>

@if (project.IsArchived)
{
    <p class="note">This project is archived, so its tasks are read-only.</p>
}

@if (!Model.Any())
{
    <div class="empty-state">No tasks yet.</div>
}
else
{
    <div class="card panel">
        @foreach (var item in Model)
        {
            var overdue = item.DueDate.HasValue && item.DueDate.Value.Date < DateTime.Today && item.Status != TaskItemStatus.Done;

            <a asp-action="Details" asp-route-id="@item.Id" class="task-row">
                <span class="key task-row-key">@project.Key-@item.Number</span>
                <span class="task-row-title">
                    @item.Title
                    @foreach (var tl in item.TaskLabels)
                    {
                        <span class="label-tag ms-1" style="color: @tl.Label.Color; border-color: @tl.Label.Color">@tl.Label.Name</span>
                    }
                </span>
                <span class="pill prio-@item.Priority.CssName()">@item.Priority</span>
                <span class="pill status-@item.Status.CssName()">@item.Status.GetDisplayName()</span>
                @if (item.Assignee != null)
                {
                    <span class="avatar avatar-sm avatar-c@(item.Assignee.Id.Sum(ch => (int)ch) % 6)" title="@item.Assignee.FullName">@item.Assignee.Initials</span>
                }
                <small class="task-row-due @(overdue ? "text-danger" : "text-muted")">
                    @(item.DueDate.HasValue ? (overdue ? "Overdue · " : "") + item.DueDate.Value.ToString("dd/MM") : "—")
                </small>
            </a>
        }
    </div>
}
