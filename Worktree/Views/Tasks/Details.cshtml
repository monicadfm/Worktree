@model Worktree.Data.Entities.TaskItem

@{
    ViewData["Title"] = Model.Project.Key + "-" + Model.Number;
    var overdue = Model.DueDate.HasValue && Model.DueDate.Value.Date < DateTime.Today && Model.Status != TaskItemStatus.Done;
    var canEdit = !Model.Project.IsArchived;
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}

<a asp-action="Board" asp-route-projectId="@Model.ProjectId" class="back-link">&larr; Back to board</a>

<div class="row g-3 align-items-start">
    <div class="col-lg-8">
        <div class="card panel">
            <div class="form-card-head">
                <span class="key-tile tile-@(Model.ProjectId % 4)">@Model.Project.Key</span>
                <div>
                    <h1>@Model.Title</h1>
                    <p><span class="key">@Model.Project.Key-@Model.Number</span> &middot; reported by @Model.CreatedBy.FullName</p>
                </div>
                <span class="pill prio-@Model.Priority.CssName() ms-auto">@Model.Priority</span>
            </div>

            <p style="white-space: pre-line">@(string.IsNullOrEmpty(Model.Description) ? "No description." : Model.Description)</p>

            @if (canEdit)
            {
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var status in Enum.GetValues<TaskItemStatus>())
                    {
                        <form asp-action="Move" method="post">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <input type="hidden" name="status" value="@status" />
                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                            <button type="submit" class="btn btn-sm @(status == Model.Status ? "btn-primary" : "btn-line")">@status.GetDisplayName()</button>
                        </form>
                    }
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-line btn-sm ms-auto">Edit task</a>
                </div>
            }
        </div>

        <div class="card list-card mt-3">
            <h2 class="pt-3">Comments <span class="tab-count">@Model.Comments.Count</span></h2>

            @if (!Model.Comments.Any())
            {
                <p class="label-usage pb-2">No comments yet.</p>
            }

            @foreach (var comment in Model.Comments.OrderBy(c => c.CreatedAt))
            {
                var isMine = comment.CreatedById == (string)ViewBag.CurrentUserId;

                <div class="member-row">
                    <span class="avatar avatar-md avatar-c@(comment.CreatedById.Sum(ch => (int)ch) % 6)">@comment.CreatedBy.Initials</span>

                    <div class="member-info">
                        <span class="member-name">@comment.CreatedBy.FullName</span>
                        <span class="member-email">
                            @comment.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")@(comment.EditedAt.HasValue ? " · edited" : "")
                        </span>
                        <p class="mb-0 mt-1" style="white-space: pre-line">@comment.Body</p>
                    </div>

                    @if (isMine && canEdit)
                    {
                        <div class="member-actions">
                            <a asp-controller="Comments" asp-action="Edit" asp-route-id="@comment.Id" class="btn btn-line btn-sm">Edit</a>
                            <form asp-controller="Comments" asp-action="Delete" asp-route-id="@comment.Id" method="post"
                                  onsubmit="return confirm('Delete this comment?');">
                                <button type="submit" class="btn btn-line-danger btn-sm">Delete</button>
                            </form>
                        </div>
                    }
                </div>
            }

            @if (canEdit)
            {
                <form asp-controller="Comments" asp-action="Create" method="post" class="add-member">
                    <input type="hidden" name="TaskItemId" value="@Model.Id" />
                    <input type="text" name="Body" class="form-control" maxlength="2000" required placeholder="Write a comment..." />
                    <button type="submit" class="btn btn-primary">Comment</button>
                </form>
            }
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card list-card">
            <div class="label-row">
                <span class="label-usage">Status</span>
                <div class="label-row-actions"><span class="pill status-@Model.Status.CssName()">@Model.Status.GetDisplayName()</span></div>
            </div>
            <div class="label-row">
                <span class="label-usage">Assignee</span>
                <div class="label-row-actions">
                    @if (Model.Assignee != null)
                    {
                        <span class="avatar avatar-sm avatar-c@(Model.Assignee.Id.Sum(ch => (int)ch) % 6)">@Model.Assignee.Initials</span>
                        @Model.Assignee.FullName
                    }
                    else
                    {
                        <span class="label-usage">Unassigned</span>
                    }
                </div>
            </div>
            <div class="label-row">
                <span class="label-usage">Reporter</span>
                <div class="label-row-actions">
                    <span class="avatar avatar-sm avatar-c@(Model.CreatedBy.Id.Sum(ch => (int)ch) % 6)">@Model.CreatedBy.Initials</span>
                    @Model.CreatedBy.FullName
                </div>
            </div>
            <div class="label-row">
                <span class="label-usage">Due</span>
                <div class="label-row-actions">
                    @if (Model.DueDate.HasValue)
                    {
                        <span class="due @(overdue ? "overdue" : "")">@(overdue ? "Overdue · " : "")@Model.DueDate.Value.ToString("dd/MM/yyyy")</span>
                    }
                    else
                    {
                        <span class="label-usage">&mdash;</span>
                    }
                </div>
            </div>
            <div class="label-row">
                <span class="label-usage">Labels</span>
                <div class="label-row-actions flex-wrap justify-content-end">
                    @if (!Model.TaskLabels.Any())
                    {
                        <span class="label-usage">None</span>
                    }
                    @foreach (var tl in Model.TaskLabels)
                    {
                        <span class="label-tag" style="color: @tl.Label.Color; border-color: @tl.Label.Color">@tl.Label.Name</span>
                    }
                </div>
            </div>
            <div class="label-row">
                <span class="label-usage">Created</span>
                <div class="label-row-actions">@Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
            </div>
            <div class="label-row">
                <span class="label-usage">Updated</span>
                <div class="label-row-actions">@Model.UpdatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
            </div>

            @if (canEdit && ViewBag.CanDelete == true)
            {
                <div class="label-row">
                    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-line-danger btn-sm">Delete task</a>
                </div>
            }
        </div>
    </div>
</div>
