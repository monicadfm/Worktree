@model Worktree.Data.Entities.TaskItem

@{
    ViewData["Title"] = Model.Project.Key + "-" + Model.Number;
    var overdue = Model.DueDate.HasValue && Model.DueDate.Value.Date < DateTime.Today && Model.Status != TaskItemStatus.Done;
}

<div class="mb-3">
    <span class="badge bg-dark fs-6">@Model.Project.Key-@Model.Number</span>
    <h1 class="d-inline align-middle ms-2">@Model.Title</h1>
</div>

<div class="row">
    <div class="col-md-8">
        <h5>Description</h5>
        <p class="text-muted" style="white-space: pre-line">@(string.IsNullOrEmpty(Model.Description) ? "No description." : Model.Description)</p>
    </div>

    <div class="col-md-4">
        <dl class="row">
            <dt class="col-5">Status</dt>
            <dd class="col-7">@Model.Status.GetDisplayName()</dd>

            <dt class="col-5">Priority</dt>
            <dd class="col-7">@Model.Priority</dd>

            <dt class="col-5">Assignee</dt>
            <dd class="col-7">@(Model.Assignee?.FullName ?? "Unassigned")</dd>

            <dt class="col-5">Due Date</dt>
            <dd class="col-7 @(overdue ? "text-danger fw-bold" : "")">
                @(Model.DueDate?.ToString("dd/MM/yyyy") ?? "—")
                @if (overdue)
                {
                    <span class="badge bg-danger">Overdue</span>
                }
            </dd>

            <dt class="col-5">Created by</dt>
            <dd class="col-7">@Model.CreatedBy.FullName</dd>

            <dt class="col-5">Created</dt>
            <dd class="col-7">@Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>

            <dt class="col-5">Updated</dt>
            <dd class="col-7">@Model.UpdatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>
        </dl>
    </div>
</div>

<div class="mt-3">
    @if (!Model.Project.IsArchived)
    {
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>

        @if (ViewBag.CanDelete == true)
        {
            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Delete</a>
        }
    }
    <a asp-action="Index" asp-route-projectId="@Model.ProjectId" class="btn btn-success">Back to List</a>
</div>