@model Worktree.Data.Entities.TaskItem

@{
    ViewData["Title"] = Model.Project.Key + "-" + Model.Number;
    var overdue = Model.DueDate.HasValue && Model.DueDate.Value.Date < DateTime.Today && Model.Status != TaskItemStatus.Done;
}

<div class="mb-3">
    <span class="badge bg-dark fs-6">@Model.Project.Key-@Model.Number</span>
    <h1 class="d-inline align-middle ms-2">@Model.Title</h1>
</div>

<div class="row">
    <div class="col-md-8">
        <h5>Description</h5>
        <p class="text-muted" style="white-space: pre-line">@(string.IsNullOrEmpty(Model.Description) ? "No description." : Model.Description)</p>

        <h5 class="mt-3">Labels</h5>
        <p>
            @if (!Model.TaskLabels.Any())
            {
                <span class="text-muted">No labels.</span>
            }
            @foreach (var tl in Model.TaskLabels)
            {
                <span class="badge me-1" style="background-color: @tl.Label.Color">@tl.Label.Name</span>
            }
        </p>
    </div>

    <div class="col-md-4">
        <dl class="row">
            <dt class="col-5">Status</dt>
            <dd class="col-7">@Model.Status.GetDisplayName()</dd>

            <dt class="col-5">Priority</dt>
            <dd class="col-7">@Model.Priority</dd>

            <dt class="col-5">Assignee</dt>
            <dd class="col-7">@(Model.Assignee?.FullName ?? "Unassigned")</dd>

            <dt class="col-5">Due Date</dt>
            <dd class="col-7 @(overdue ? "text-danger fw-bold" : "")">
                @(Model.DueDate?.ToString("dd/MM/yyyy") ?? "—")
                @if (overdue)
                {
                    <span class="badge bg-danger">Overdue</span>
                }
            </dd>

            <dt class="col-5">Created by</dt>
            <dd class="col-7">@Model.CreatedBy.FullName</dd>

            <dt class="col-5">Created</dt>
            <dd class="col-7">@Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>

            <dt class="col-5">Updated</dt>
            <dd class="col-7">@Model.UpdatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>
        </dl>
    </div>
</div>

<div class="mt-3">
    @if (!Model.Project.IsArchived)
    {
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>

        @if (ViewBag.CanDelete == true)
        {
            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Delete</a>
        }
    }
    <a asp-action="Index" asp-route-projectId="@Model.ProjectId" class="btn btn-success">Back to List</a>
</div>

<hr class="my-4" />

<h4>Comments <span class="text-muted fs-6">(@Model.Comments.Count)</span></h4>

@if (!Model.Comments.Any())
{
    <p class="text-muted">No comments yet.</p>
}

@foreach (var comment in Model.Comments.OrderBy(c => c.CreatedAt))
{
    var isMine = comment.CreatedById == (string)ViewBag.CurrentUserId;

    <div class="card mb-2">
        <div class="card-body py-2">
            <div class="d-flex justify-content-between">
                <div>
                    <strong>@comment.CreatedBy.FullName</strong>
                    <small class="text-muted ms-2">
                        @comment.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                        @if (comment.EditedAt.HasValue)
                        {
                            <span>(edited)</span>
                        }
                    </small>
                </div>

                @if (isMine && !Model.Project.IsArchived)
                {
                    <div>
                        <a asp-controller="Comments" asp-action="Edit" asp-route-id="@comment.Id" class="btn btn-link btn-sm p-0 me-2">Edit</a>
                        <form asp-controller="Comments" asp-action="Delete" asp-route-id="@comment.Id" method="post" class="d-inline"
                              onsubmit="return confirm('Delete this comment?');">
                            <button type="submit" class="btn btn-link btn-sm p-0 text-danger">Delete</button>
                        </form>
                    </div>
                }
            </div>
            <p class="mb-0 mt-1" style="white-space: pre-line">@comment.Body</p>
        </div>
    </div>
}

@if (!Model.Project.IsArchived)
{
    <form asp-controller="Comments" asp-action="Create" method="post" class="mt-3">
        <input type="hidden" name="TaskItemId" value="@Model.Id" />
        <div class="mb-2">
            <textarea name="Body" class="form-control" rows="3" maxlength="2000" required
                      placeholder="Write a comment..."></textarea>
        </div>
        <button type="submit" class="btn btn-primary">Add comment</button>
    </form>
}