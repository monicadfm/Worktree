@model Worktree.Models.TaskViewModel

@{
    ViewData["Title"] = "New task";
}

<a asp-action="Board" asp-route-projectId="@Model.ProjectId" class="back-link">&larr; Back to board</a>

<div class="card form-card form-card-wide">
    <div class="form-card-head">
        <span class="key-tile tile-@(Model.ProjectId % 4)">@Model.ProjectKey</span>
        <div>
            <h1>New task</h1>
            <p>Add a task to @Model.ProjectKey.</p>
        </div>
    </div>

    <form asp-action="Create" class="form-stack">
        <div asp-validation-summary="ModelOnly" class="auth-error"></div>

        <partial name="_TaskForm" />

        <div class="form-footer">
            <button type="submit" class="btn btn-primary">Create task</button>
            <a asp-action="Board" asp-route-projectId="@Model.ProjectId" class="btn btn-line">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
