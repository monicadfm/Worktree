@model Worktree.Data.Entities.TaskItem

@{
    ViewData["Title"] = "Delete Task";
    var commentCount = Model.Comments.Count;
}

<a asp-action="Details" asp-route-id="@Model.Id" class="back-link">&larr; Back to task</a>

<div class="card form-card">
    <div class="form-card-head">
        <span class="key-tile tile-@(Model.ProjectId % 4)">@Model.Project.Key</span>
        <div>
            <h1>Delete @Model.Project.Key-@Model.Number?</h1>
            <p>@Model.Title</p>
        </div>
    </div>

    <form asp-action="Delete" class="form-stack">
        <input type="hidden" asp-for="Id" />

        <div class="auth-error">
            Delete @Model.Project.Key-@Model.Number@(commentCount > 0 ? $" and its {commentCount} comment{(commentCount == 1 ? "" : "s")}" : "")? This can't be undone.
        </div>

        <div class="d-flex flex-wrap gap-2">
            <span class="pill status-@Model.Status.CssName()">@Model.Status.GetDisplayName()</span>
            <span class="pill prio-@Model.Priority.CssName()">@Model.Priority</span>
        </div>

        <div class="form-footer danger-actions">
            <button type="submit" class="btn btn-danger">Yes, delete</button>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-line">Keep it</a>
        </div>
    </form>
</div>
