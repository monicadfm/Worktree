@model Worktree.Data.Entities.TaskItem

@{
    ViewData["Title"] = "Delete Task";
}

<h1>Delete Task</h1>
<hr />

<h3>Are you sure you want to delete this task?</h3>

<dl class="row mt-3">
    <dt class="col-sm-2">Task</dt>
    <dd class="col-sm-10"><span class="badge bg-secondary">@Model.Project.Key-@Model.Number</span> @Model.Title</dd>
    <dt class="col-sm-2">Status</dt>
    <dd class="col-sm-10">@Model.Status.GetDisplayName()</dd>
</dl>

<p class="text-muted">Its comments and labels will also be removed. This can't be undone.</p>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <input type="submit" value="Delete" class="btn btn-danger" />
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-success">Back</a>
</form>