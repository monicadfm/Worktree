@model Worktree.Models.BoardViewModel

@{
    ViewData["Title"] = Model.Project.Name + " - Board";
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    var statuses = Enum.GetValues<TaskItemStatus>();
    var activeFilters = (string.IsNullOrEmpty(Model.AssigneeId) ? 0 : 1)
        + (Model.LabelId.HasValue ? 1 : 0)
        + (Model.Priority.HasValue ? 1 : 0);
}

<partial name="_BoardHeader" model="Model.Header" />

<div class="board-toolbar">
    @if (!Model.Project.IsArchived)
    {
        <form asp-action="QuickAdd" method="post" class="quick-add">
            <input type="hidden" name="projectId" value="@Model.Project.Id" />
            <input type="text" name="title" class="form-control" placeholder="Quick add: new task title..." minlength="3" maxlength="120" required />
            <button type="submit" class="btn btn-primary">Add task</button>
        </form>
        <a asp-action="Create" asp-route-projectId="@Model.Project.Id" class="btn btn-line">New task with details...</a>
    }

    <div class="board-toolbar-end">
        @if (activeFilters > 0)
        {
            <a asp-action="Board" asp-route-projectId="@Model.Project.Id" class="clear-filters">Clear filters</a>
        }
        <button type="button" class="btn btn-line" data-bs-toggle="offcanvas" data-bs-target="#board-filters" aria-controls="board-filters">
            <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M3 5h18l-7 8v6l-4 2v-8z" />
            </svg>
            Filters
            @if (activeFilters > 0)
            {
                <span class="filter-count">@activeFilters</span>
            }
        </button>
        <a asp-action="Index" asp-route-projectId="@Model.Project.Id" class="btn btn-line btn-icon" title="List view" aria-label="List view">
            <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M9 6h12M9 12h12M9 18h12M4 6h.01M4 12h.01M4 18h.01" />
            </svg>
        </a>
    </div>
</div>

@if (TempData["QuickAddError"] != null)
{
    <p class="quick-add-error">@TempData["QuickAddError"]</p>
}

<div class="offcanvas offcanvas-end filter-panel" tabindex="-1" id="board-filters" aria-labelledby="board-filters-title">
    <div class="offcanvas-header">
        <h2 class="offcanvas-title" id="board-filters-title">Filters</h2>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">
        <form asp-action="Board" method="get" class="filter-form">
            <input type="hidden" name="projectId" value="@Model.Project.Id" />

            <div>
                <label asp-for="AssigneeId" class="form-label">Assignee</label>
                <select asp-for="AssigneeId" asp-items="Model.Members" class="form-select"></select>
            </div>

            <div>
                <label asp-for="LabelId" class="form-label">Label</label>
                <select asp-for="LabelId" asp-items="Model.Labels" class="form-select"></select>
            </div>

            <div>
                <label asp-for="Priority" class="form-label">Priority</label>
                <select asp-for="Priority" asp-items="Html.GetEnumSelectList<TaskItemPrio>()" class="form-select">
                    <option value="">All priorities</option>
                </select>
            </div>

            <div class="filter-actions">
                <button type="submit" class="btn btn-primary">Apply</button>
                <a asp-action="Board" asp-route-projectId="@Model.Project.Id" class="btn btn-line">Clear</a>
            </div>
        </form>
    </div>
</div>

<div class="board">
    @foreach (var status in statuses)
    {
        var columnTasks = Model.Tasks.Where(t => t.Status == status).ToList();

        <div class="board-col">
            <div class="board-col-head">
                <span>@status.GetDisplayName()</span>
                <span class="pill pill-muted">@columnTasks.Count</span>
            </div>

            @if (!columnTasks.Any())
            {
                <p class="text-muted small text-center my-4">No tasks</p>
            }

            @foreach (var task in columnTasks)
            {
                var overdue = task.DueDate.HasValue && task.DueDate.Value.Date < DateTime.Today && task.Status != TaskItemStatus.Done;

                <div class="task-card">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="key">@Model.Project.Key-@task.Number</span>
                        <span class="pill prio-@task.Priority.CssName()">@task.Priority</span>
                    </div>

                    <a asp-action="Details" asp-route-id="@task.Id" class="task-title">@task.Title</a>

                    @if (task.TaskLabels.Any())
                    {
                        <div class="d-flex flex-wrap gap-1 mb-2">
                            @foreach (var tl in task.TaskLabels)
                            {
                                <span class="label-tag" style="color: @tl.Label.Color; border-color: @tl.Label.Color">@tl.Label.Name</span>
                            }
                        </div>
                    }

                    <div class="task-card-foot">
                        <span class="d-flex align-items-center gap-2">
                            @if (task.Assignee != null)
                            {
                                <span class="avatar avatar-sm" title="@task.Assignee.FullName">@task.Assignee.Initials</span>
                            }
                            @if (task.DueDate.HasValue)
                            {
                                <span class="due @(overdue ? "overdue" : "")">@(overdue ? "Overdue · " : "")@task.DueDate.Value.ToString("dd/MM")</span>
                            }
                        </span>

                        @if (!Model.Project.IsArchived)
                        {
                            <div class="dropdown">
                                <button type="button" class="btn btn-line btn-move" data-bs-toggle="dropdown" aria-expanded="false">Move &rarr;</button>
                                <ul class="dropdown-menu dropdown-menu-end move-menu">
                                    @foreach (var target in statuses.Where(s => s != status))
                                    {
                                        <li>
                                            <form asp-action="Move" method="post">
                                                <input type="hidden" name="id" value="@task.Id" />
                                                <input type="hidden" name="status" value="@target" />
                                                <input type="hidden" name="returnUrl" value="@returnUrl" />
                                                <button type="submit" class="dropdown-item">@target.GetDisplayName()</button>
                                            </form>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>
