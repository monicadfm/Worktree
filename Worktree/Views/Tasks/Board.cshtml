@model Worktree.Models.BoardViewModel

@{
    ViewData["Title"] = Model.Project.Name + " - Board";
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    var statuses = Enum.GetValues<TaskItemStatus>();
}

<partial name="_BoardHeader" model="Model.Header" />

<div class="d-flex justify-content-end gap-2 mb-3">
    @if (!Model.Project.IsArchived)
    {
        <a asp-action="Create" asp-route-projectId="@Model.Project.Id" class="btn btn-primary">New Task</a>
    }
    <a asp-action="Index" asp-route-projectId="@Model.Project.Id" class="btn btn-line">List view</a>
</div>

<form asp-action="Board" method="get" class="row g-2 mb-3">
    <input type="hidden" name="projectId" value="@Model.Project.Id" />
    <div class="col-md-3">
        <select asp-for="AssigneeId" asp-items="Model.Members" class="form-select form-select-sm"></select>
    </div>
    <div class="col-md-3">
        <select asp-for="LabelId" asp-items="Model.Labels" class="form-select form-select-sm"></select>
    </div>
    <div class="col-md-3">
        <select asp-for="Priority" asp-items="Html.GetEnumSelectList<TaskItemPrio>()" class="form-select form-select-sm">
            <option value="">All priorities</option>
        </select>
    </div>
    <div class="col-md-3">
        <button type="submit" class="btn btn-sm btn-primary">Filter</button>
        <a asp-action="Board" asp-route-projectId="@Model.Project.Id" class="btn btn-sm btn-secondary">Clear</a>
    </div>
</form>

<div class="board">
    @foreach (var status in statuses)
    {
        var columnTasks = Model.Tasks.Where(t => t.Status == status).ToList();

        <div class="board-col">
            <div class="board-col-head">
                <span>@status.GetDisplayName()</span>
                <span class="pill pill-muted">@columnTasks.Count</span>
            </div>

            @if (!columnTasks.Any())
            {
                <p class="text-muted small text-center my-4">No tasks</p>
            }

            @foreach (var task in columnTasks)
            {
                var overdue = task.DueDate.HasValue && task.DueDate.Value.Date < DateTime.Today && task.Status != TaskItemStatus.Done;

                <div class="task-card">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="key">@Model.Project.Key-@task.Number</span>
                        <span class="pill prio-@task.Priority.CssName()">@task.Priority</span>
                    </div>

                    <a asp-action="Details" asp-route-id="@task.Id" class="task-title">@task.Title</a>

                    @if (task.TaskLabels.Any())
                    {
                        <div class="d-flex flex-wrap gap-1 mb-2">
                            @foreach (var tl in task.TaskLabels)
                            {
                                <span class="label-tag" style="color: @tl.Label.Color; border-color: @tl.Label.Color">@tl.Label.Name</span>
                            }
                        </div>
                    }

                    <div class="d-flex justify-content-between align-items-center">
                        <span class="d-flex align-items-center gap-2 small text-muted">
                            @if (task.Assignee != null)
                            {
                                <span class="avatar avatar-sm">@task.Assignee.Initials</span>
                                <span>@task.Assignee.FirstName</span>
                            }
                            else
                            {
                                <span>Unassigned</span>
                            }
                        </span>
                        @if (task.DueDate.HasValue)
                        {
                            <small class="@(overdue ? "text-danger fw-semibold" : "text-muted")">@(overdue ? "Overdue · " : "")@task.DueDate.Value.ToString("dd/MM")</small>
                        }
                    </div>

                    @if (!Model.Project.IsArchived)
                    {
                        <div class="d-flex justify-content-between mt-2">
                            @if (status != TaskItemStatus.ToDo)
                            {
                                <form asp-action="Move" method="post">
                                    <input type="hidden" name="id" value="@task.Id" />
                                    <input type="hidden" name="status" value="@(status - 1)" />
                                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                                    <button type="submit" class="btn btn-line btn-sm"
                                            title="Move to @((status - 1).GetDisplayName())">
                                        &larr;
                                    </button>
                                </form>
                            }
                            else
                            {
                                <span></span>
                            }

                            @if (status != TaskItemStatus.Done)
                            {
                                <form asp-action="Move" method="post">
                                    <input type="hidden" name="id" value="@task.Id" />
                                    <input type="hidden" name="status" value="@(status + 1)" />
                                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                                    <button type="submit" class="btn btn-line btn-sm"
                                            title="Move to @((status + 1).GetDisplayName())">
                                        &rarr;
                                    </button>
                                </form>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>
