@model Worktree.Models.BoardViewModel

@{
    ViewData["Title"] = Model.Project.Name + " - Board";
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    var statuses = Enum.GetValues<TaskItemStatus>();
}

@functions {
    string PriorityBadge(TaskItemPrio p) => p switch
    {
        TaskItemPrio.Low => "bg-light text-dark",
        TaskItemPrio.Medium => "bg-info text-dark",
        TaskItemPrio.High => "bg-warning text-dark",
        _ => "bg-danger"
    };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>
        <span class="badge bg-dark align-middle">@Model.Project.Key</span> Board
        @if (Model.Project.IsArchived)
        {
            <span class="badge bg-secondary align-middle fs-6">Archived</span>
        }
    </h1>
    <div>
        @if (!Model.Project.IsArchived)
        {
            <a asp-action="Create" asp-route-projectId="@Model.Project.Id" class="btn btn-primary">New Task</a>
        }
        <a asp-action="Index" asp-route-projectId="@Model.Project.Id" class="btn btn-outline-secondary">List view</a>
        <a asp-controller="Projects" asp-action="Details" asp-route-id="@Model.Project.Id" class="btn btn-success">Back to Project</a>
    </div>
</div>

<form asp-action="Board" method="get" class="row g-2 mb-3">
    <input type="hidden" name="projectId" value="@Model.Project.Id" />
    <div class="col-md-3">
        <select asp-for="AssigneeId" asp-items="Model.Members" class="form-select form-select-sm"></select>
    </div>
    <div class="col-md-3">
        <select asp-for="LabelId" asp-items="Model.Labels" class="form-select form-select-sm"></select>
    </div>
    <div class="col-md-3">
        <select asp-for="Priority" asp-items="Html.GetEnumSelectList<TaskItemPrio>()" class="form-select form-select-sm">
            <option value="">All priorities</option>
        </select>
    </div>
    <div class="col-md-3">
        <button type="submit" class="btn btn-sm btn-primary">Filter</button>
        <a asp-action="Board" asp-route-projectId="@Model.Project.Id" class="btn btn-sm btn-outline-secondary">Clear</a>
    </div>
</form>

<div class="row g-3">
    @foreach (var status in statuses)
    {
        var columnTasks = Model.Tasks.Where(t => t.Status == status).ToList();

        <div class="col-md-3">
            <div class="bg-light rounded p-2 h-100">
                <h6 class="d-flex justify-content-between align-items-center px-1 mb-2">
                    <span>@status.GetDisplayName()</span>
                    <span class="badge bg-secondary">@columnTasks.Count</span>
                </h6>

                @if (!columnTasks.Any())
                {
                    <p class="text-muted small text-center my-4">No tasks</p>
                }

                @foreach (var task in columnTasks)
                {
                    var overdue = task.DueDate.HasValue && task.DueDate.Value.Date < DateTime.Today && task.Status != TaskItemStatus.Done;

                    <div class="card mb-2 shadow-sm">
                        <div class="card-body p-2">
                            <div class="d-flex justify-content-between">
                                <small class="text-muted">@Model.Project.Key-@task.Number</small>
                                <span class="badge @PriorityBadge(task.Priority)">@task.Priority</span>
                            </div>

                            <a asp-action="Details" asp-route-id="@task.Id" class="d-block fw-semibold text-decoration-none text-dark my-1">
                                @task.Title
                            </a>

                            @foreach (var tl in task.TaskLabels)
                            {
                                <span class="badge me-1" style="background-color: @tl.Label.Color">@tl.Label.Name</span>
                            }

                            <div class="d-flex justify-content-between align-items-center mt-2">
                                <small class="text-muted">@(task.Assignee?.FullName ?? "Unassigned")</small>
                                @if (task.DueDate.HasValue)
                                {
                                    <small class="@(overdue ? "text-danger fw-bold" : "text-muted")">@task.DueDate.Value.ToString("dd/MM")</small>
                                }
                            </div>

                            @if (!Model.Project.IsArchived)
                            {
                                <div class="d-flex justify-content-between mt-2">
                                    @if (status != TaskItemStatus.ToDo)
                                    {
                                        <form asp-action="Move" method="post">
                                            <input type="hidden" name="id" value="@task.Id" />
                                            <input type="hidden" name="status" value="@(status - 1)" />
                                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                                            <button type="submit" class="btn btn-outline-secondary btn-sm"
                                                    title="Move to @((status - 1).GetDisplayName())">
                                                &larr;
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span></span>
                                    }

                                    @if (status != TaskItemStatus.Done)
                                    {
                                        <form asp-action="Move" method="post">
                                            <input type="hidden" name="id" value="@task.Id" />
                                            <input type="hidden" name="status" value="@(status + 1)" />
                                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                                            <button type="submit" class="btn btn-outline-primary btn-sm"
                                                    title="Move to @((status + 1).GetDisplayName())">
                                                &rarr;
                                            </button>
                                        </form>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>